load("@rules_go//go:def.bzl", "go_library")
load("//bazel:go_test.bzl", "smart_go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    embedsrcs = ["config.yml"],
    importpath = "github.com/mocoarow/cocotola-1.26/cocotola-audio-generator/config",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_go_playground_validator_v10//:validator",
        "@in_yaml_go_yaml_v4//:yaml",
    ],
)

smart_go_test(
    name = "config_test",
    srcs = ["config_s_test.go"],
    deps = [
        ":config",
        "@com_github_stretchr_testify//assert",
    ],
)
